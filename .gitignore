# Data — data/derived is committed; everything else under data/ is not.
# data/interim holds person-level CPS rows (IPUMS terms forbid redistributing
# them) and large files the notebooks rebuild in seconds.
data/*
!data/derived/

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/

# Secrets
.env
.env.*
!.env.example

# Node (for when the app arrives)
node_modules/
.next/
dist/

# Editors / OS
.DS_Store
.vscode/
.idea/
*.swp
